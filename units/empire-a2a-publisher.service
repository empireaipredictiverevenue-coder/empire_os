[Unit]
Description=Empire OS A2A publisher (GitHub + A2A registry)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/empire_os
Environment=EMPIRE_DB=/root/empire_os/empire_os.db A2A_CARD_BASE=http://216.128.149.56:8086 BSC_WALLET_ADDRESS=0x1339b487046B0ad924a10c20b1791608EA8595a8
ExecStart=/root/venv/bin/python3 /root/empire_os/empire_os/a2a_publisher.py --daemon --interval 21600
Restart=always
RestartSec=60
User=root

[Install]
WantedBy=multi-user.target
