[Unit]
Description=Empire OS Innovator Agent — Weekly Ship Proposals
After=network.target empire-hub-8081.service
Wants=empire-hub-8081.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/empire_os
ExecStart=/root/venv/bin/python3 -m empire_os.agents.innovator_agent
Restart=always
RestartSec=300
Environment=PYTHONUNBUFFERED=1 OLLAMA_HOST=http://127.0.0.1:11434 LLM_MODEL=qwen2.5:7b
StandardOutput=append:/root/empire_os/logs/innovator_agent.log
StandardError=append:/root/empire_os/logs/innovator_agent.log

[Install]
WantedBy=multi-user.target