[Unit]
Description=Empire OS Crawler Watchdog (self-heal crawler/lead-gen procs)
After=network.target empire-hub-8081.service
Wants=empire-hub-8081.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/empire_os
EnvironmentFile=-/root/empire_os/.env
ExecStart=/root/venv/bin/python3 -u /root/empire_os/empire_os/crawler_watchdog.py
StandardOutput=append:/root/empire_os/logs/crawler_watchdog.log
StandardError=append:/root/empire_os/logs/crawler_watchdog.log

[Install]
WantedBy=multi-user.target
