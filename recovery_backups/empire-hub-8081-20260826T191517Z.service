[Unit]
Description=Empire OS Hub (8081, revenue loop)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/empire_os
Environment=EMPIRE_PORT=8081
Environment=EMPIRE_HOST=0.0.0.0
Environment=EMPIRE_DB_PATH=/root/empire_os/empire_os.db
ExecStart=/root/venv/bin/python3 -m empire_os.hub --host 0.0.0.0 --port 8081
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
