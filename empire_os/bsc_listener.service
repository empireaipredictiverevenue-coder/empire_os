[Unit]
Description=Empire OS BSC USDT Settlement Listener
After=network.target empire-hub-8081.service
Wants=empire-hub-8081.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/empire_os
EnvironmentFile=-/root/empire_os/.env
Environment=BSC_WALLET_ADDRESS=0x1339b487046B0ad924a10c20b1791608EA8595a8
Environment=BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ExecStart=/root/venv/bin/python3 /root/empire_os/empire_os/bsc_listener.py
Restart=always
RestartSec=10
StandardOutput=append:/root/empire_os/logs/bsc_listener.log
StandardError=append:/root/empire_os/logs/bsc_listener.log

[Install]
WantedBy=multi-user.target
