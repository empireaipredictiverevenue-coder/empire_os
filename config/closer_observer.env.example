# Governed closer runtime is OBSERVE-only in the current phase.
EMPIRE_CLOSER_MODE=OBSERVE

# Provision only after the dedicated observer login is approved and receives a password.
EMPIRE_CLOSER_OBSERVER_DSN=

# Bounded real-reply work projection.
EMPIRE_CLOSER_WORK_LIMIT=50
EMPIRE_CLOSER_OUTPUT_PATH=/srv/empire_os/runtime/closer/latest.json

# Staged for future explicitly approved roles; not consumed by the OBSERVE worker.
EMPIRE_CLOSER_PLANNER_DSN=
EMPIRE_CLOSER_APPROVER_DSN=
