# Empire Coder is OBSERVE-first. Do not set LIVE.
EMPIRE_CODER_MODE=OBSERVE

# Local Ollama inference only.
EMPIRE_CODER_OLLAMA_URL=http://127.0.0.1:11434
EMPIRE_CODER_LOCAL_MODEL=qwen3-coder:30b
EMPIRE_CODER_CONTEXT_LENGTH=16384
EMPIRE_CODER_MODEL_TIMEOUT_SECONDS=600

# Local task/audit state. runtime/ is gitignored.
EMPIRE_CODER_RUNTIME_ROOT=/srv/empire_os/runtime/coder

# Internal HTTP control plane. Disabled unless explicitly activated.
EMPIRE_CODER_API_ENABLED=0
EMPIRE_CODER_API_INTERNAL_TOKEN=
EMPIRE_CODER_WORKSPACE=/srv/empire_os

# Resumable proposal queue.
EMPIRE_CODER_JOB_STALE_SECONDS=1800
