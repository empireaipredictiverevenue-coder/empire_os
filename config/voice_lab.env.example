# Empire Voice Lab - self-hosted speech only
# Safe default. Promote only after /v1/voice-lab/health is green.
EMPIRE_PHONE_MODE=OBSERVE
EMPIRE_PHONE_LIVE_AUTHORITY=false

# Canonical public callbacks.
EMPIRE_PUBLIC_BASE_URL=https://empire-ai.co.uk
EMPIRE_VONAGE_ANSWER_URL=https://empire-ai.co.uk/v1/voice-lab/vonage/answer
EMPIRE_VONAGE_EVENT_URL=https://empire-ai.co.uk/v1/voice-lab/vonage/event

# Generate locally; do not commit real values.
EMPIRE_VONAGE_WEBHOOK_TOKEN=
EMPIRE_VOICE_WS_TOKEN=

# Existing Vonage application credentials.
VONAGE_APPLICATION_ID=
VONAGE_APPLICATION_PRIVATE_KEY_PATH=
VONAGE_VIRTUAL_NUMBER=

# Native STT / TTS
EMPIRE_VOICE_STT_BACKEND=faster_whisper
EMPIRE_VOICE_STT_MODEL=small.en
EMPIRE_VOICE_TTS_BACKEND=kokoro
EMPIRE_VOICE_TTS_VOICE=af_heart
EMPIRE_VOICE_DEVICE=cpu
EMPIRE_VOICE_COMPUTE_TYPE=int8

# Existing local LLM / Hermes-compatible endpoint may replace these.
EMPIRE_VOICE_LLM_BASE_URL=http://127.0.0.1:11434
EMPIRE_VOICE_LLM_MODEL=qwen2.5:7b
EMPIRE_VOICE_LLM_TIMEOUT=12
