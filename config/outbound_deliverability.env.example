# Empire outbound Ringleader deliverability observer
# Safe default: OBSERVE only. This module has no live-send code path.
EMPIRE_OUTBOUND_RINGLEADER_MODE=OBSERVE

# Multi-tenant/canonical EmpireDB scope.
EMPIRE_OUTBOUND_SCOPE_KEY=empire

# Telemetry adapter currently supported by the observer runtime.
EMPIRE_OUTBOUND_TELEMETRY_SOURCE=resend

# Optional bounded context produced by auth/domain observers.
EMPIRE_OUTBOUND_RINGLEADER_CONTEXT_PATH=/srv/empire_os/runtime/outbound/ringleader_context.json

# Optional read-only bundle written by Empire-owned/open-source observers.
# Missing/stale bundles are reported and ignored; they never authorize mutation.
EMPIRE_OUTBOUND_EVIDENCE_BUNDLE_PATH=/srv/empire_os/runtime/outbound/evidence_bundle.json

# Optional authenticity gate for locally-produced evidence.
# Keep the key in the runtime secret file, never in source control.
EMPIRE_OUTBOUND_REQUIRE_SIGNED_EVIDENCE_BUNDLE=false
EMPIRE_OUTBOUND_EVIDENCE_BUNDLE_HMAC_KEY=

# Dedicated least-privilege EmpireDB bindings.
# Leave blank until outbound migrations 033-041 and the dedicated roles are explicitly approved/activated.
EMPIRE_OUTBOUND_DELIVERABILITY_READER_DSN=
EMPIRE_OUTBOUND_DELIVERABILITY_WRITER_DSN=

# Set true only after EmpireDB migrations/roles are explicitly activated.
EMPIRE_OUTBOUND_REQUIRE_PERSISTENCE=false

# Sender-estate reconciliation queries migration 035/036/040 state through
# the read-only EmpireDB role. Keep disabled until that schema is activated.
EMPIRE_OUTBOUND_ENABLE_ESTATE_RECONCILIATION=false

# Successful OBSERVE cycles write a non-authorizing local heartbeat.
EMPIRE_OUTBOUND_OBSERVER_HEARTBEAT_PATH=/srv/empire_os/runtime/outbound/ringleader_observer_heartbeat.json
EMPIRE_OUTBOUND_OBSERVER_MAX_AGE_MINUTES=15

# Read-only provider telemetry source.
# Keep the real key in runtime secrets, never commit it.
RESEND_API_KEY=
