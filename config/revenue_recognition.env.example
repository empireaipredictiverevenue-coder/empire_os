# Safe default: inspect verified settlement evidence only.
EMPIRE_REVENUE_RECOGNITION_MODE=OBSERVE
EMPIRE_REVENUE_RECOGNITION_ACTOR=revenue_recognition_worker

# Provision locally after the runtime role login receives a password.
EMPIRE_REVENUE_RECOGNIZER_DSN=

# Used by delivery/CRM feedback ingestion.
EMPIRE_OUTCOME_RECORDER_DSN=

# Dedicated read-only outcome figures identity for dashboards/reporting.
EMPIRE_OUTCOME_READER_DSN=
