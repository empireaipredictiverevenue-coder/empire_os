# Phase 5 Search Intelligence remains OBSERVE/recommendation-only.
# Repository activation requires BOTH bindings. If either is missing,
# /v1/search repository-backed GET routes remain fail-closed at 503.
EMPIRE_SEARCH_READER_DSN=
EMPIRE_SEARCH_TENANT_KEY=

EMPIRE_SEARCH_QUALITY_THRESHOLD=0.75
EMPIRE_SEARCH_MIN_QUALITY_FACTORS=8

# Google Search Console is disabled until credential activation is approved.
# The runtime checks only that the file binding exists; it does not read
# credential contents until a real adapter is separately implemented/approved.
EMPIRE_SEARCH_CONSOLE_ENABLED=false
EMPIRE_SEARCH_CONSOLE_SITE_URL=
EMPIRE_SEARCH_CONSOLE_CREDENTIAL_FILE=

# Separate bounded approval gate for real Search Console network reads.
EMPIRE_SEARCH_CONSOLE_ACTIVATION_APPROVED=false
