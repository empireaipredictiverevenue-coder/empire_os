# Safe default: evaluate and log only.
EMPIRE_OUTBOUND_GOVERNOR_MODE=OBSERVE
EMPIRE_OUTBOUND_AUTO_APPROVE=false
EMPIRE_OUTBOUND_AUTO_SEND=false
EMPIRE_OPERATOR_ID=outbound_governor
EMPIRE_GTM_DAILY_EXTERNAL_CAP=25
EMPIRE_SUPABASE_MAX_REQUESTS_PER_HOUR=3000
EMPIRE_SUPABASE_MAX_REQUESTS_PER_COMPONENT_HOUR=1000
EMPIRE_SUPABASE_MAX_REQUESTS_PER_DAY=25000
EMPIRE_SUPABASE_EGRESS_PROBE_SECONDS=1800

# Required only when promoting auto-approval.
# Enter the dedicated approver DSN locally; never commit it.
EMPIRE_OUTBOUND_APPROVER_DSN=

# Branded commercial identity used by the governed Resend path.
EMPIRE_OUTBOUND_FROM=Phil - Founder - Empire AI <phil@mail.empire-ai.co.uk>
EMPIRE_REPLY_TO=reply@mail.empire-ai.co.uk

# Required only when promoting auto-send.
# Keep the real key in the runtime secret environment; never commit it.
RESEND_API_KEY=
