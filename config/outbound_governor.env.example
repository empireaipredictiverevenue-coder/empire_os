# Safe default: evaluate and log only.
EMPIRE_OUTBOUND_GOVERNOR_MODE=OBSERVE
EMPIRE_OUTBOUND_AUTO_APPROVE=false
EMPIRE_OUTBOUND_AUTO_SEND=false
EMPIRE_OPERATOR_ID=outbound_governor
EMPIRE_GTM_DAILY_EXTERNAL_CAP=25

# Required only when promoting auto-approval.
# Enter the dedicated approver DSN locally; never commit it.
EMPIRE_OUTBOUND_APPROVER_DSN=

# Required only when promoting auto-send.
# Keep the real key in /srv/empire_os/.env.outbound_governor only.
RESEND_API_KEY=
