# Phase 4 Astra observer is hard-fail-closed to OBSERVE.
EMPIRE_ASTRA_MODE=OBSERVE

# Preferred production transport: HTTPS token-authenticated read-only RPC.
# The raw observer token stays on EmpireOS; Supabase stores only its SHA-256 hash.
EMPIRE_ASTRA_SUPABASE_URL=
EMPIRE_ASTRA_SUPABASE_PUBLISHABLE_KEY=
EMPIRE_ASTRA_OBSERVER_TOKEN_FILE=/srv/empire_os/runtime/astra/observer_token

# Optional legacy/direct-Postgres transport for local/test environments only.
EMPIRE_ASTRA_OBSERVER_DSN=

# Bounded Phase 3F feedback calibration.
EMPIRE_ASTRA_FEEDBACK_LIMIT=100
EMPIRE_ASTRA_MIN_OUTCOME_SAMPLES=20
EMPIRE_ASTRA_MIN_CONVERSIONS=5

# Explicit policy/runtime bindings. Conservative production defaults preserve
# unknown/unverified state rather than inventing healthy capability.
EMPIRE_ASTRA_PREMIUM_AI_BUDGET_CENTS=0
EMPIRE_ASTRA_OUTBOUND_DOMAIN_VERIFIED=false

# Prefer live source-health evidence over a static boolean.
EMPIRE_ASTRA_SOURCE_HEALTH_FILE=/srv/empire_os/runtime/source_health/latest.json
EMPIRE_ASTRA_SOURCE_HEALTH_MAX_AGE_SECONDS=1800
# Compatibility/emergency override only:
# EMPIRE_ASTRA_SOURCE_HEALTH_OK=false

# Compatibility override only. If set, must contain every AstraSnapshot field.
# Canonical operational evidence is preferred.
# EMPIRE_ASTRA_OPERATIONAL_SNAPSHOT_JSON=

EMPIRE_ASTRA_OUTPUT_PATH=/srv/empire_os/runtime/astra/latest.json
