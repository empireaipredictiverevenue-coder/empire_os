# Phase 4 Astra observer is hard-fail-closed to OBSERVE.
EMPIRE_ASTRA_MODE=OBSERVE

# Provision only after the dedicated observer login receives a password.
EMPIRE_ASTRA_OBSERVER_DSN=

# Bounded Phase 3F feedback calibration.
EMPIRE_ASTRA_FEEDBACK_LIMIT=100
EMPIRE_ASTRA_MIN_OUTCOME_SAMPLES=20
EMPIRE_ASTRA_MIN_CONVERSIONS=5

# Optional. Must contain every AstraSnapshot field or the observer rejects it.
# Leave unset until an evidence-backed operational snapshot producer exists.
# EMPIRE_ASTRA_OPERATIONAL_SNAPSHOT_JSON=

EMPIRE_ASTRA_OUTPUT_PATH=/srv/empire_os/runtime/astra/latest.json
