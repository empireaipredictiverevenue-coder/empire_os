[Unit]
Description=Empire AI Lead Intel: schema-aware scoring + funnel signal snapshot
Documentation=https://hermes-agent.nousresearch.com/docs
After=network-online.target empire-hub-8081.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/empire_os
EnvironmentFile=/root/empire_os/.env
ExecStart=/root/venv/bin/python3 /root/empire_os/empire_os/agents/empire_ai_intel.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=empire-ai-intel
TimeoutStartSec=60
TimeoutStopSec=10
