[Unit]
Description=EmpireOS Control Fabric observer
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_OPS_HEAL_MODE=OBSERVE
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_ops_control_cycle.py
ExecStartPost=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/build_control_fabric_snapshot.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=180
