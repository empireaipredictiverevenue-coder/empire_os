[Unit]
Description=Refresh Predictive Cloud Opportunity Radar
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/build_opportunity_radar.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=120
