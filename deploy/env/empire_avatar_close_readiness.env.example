# Empire Digital Avatar canonical close-readiness enrichment
# Canonical database credentials remain in /etc/empiredb.env.
EMPIRE_AVATAR_CLOSE_READINESS_ROOT=/srv/empire_os/runtime/digital_avatar/close_readiness
EMPIRE_AVATAR_CLOSE_READINESS_STATUS=/srv/empire_os/runtime/digital_avatar/close_readiness_status.json
EMPIRE_AVATAR_CLOSE_READINESS_POLL_SECONDS=2.0
EMPIRE_AVATAR_CLOSE_READINESS_MAX_SESSIONS=25
