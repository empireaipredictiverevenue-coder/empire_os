# Empire Digital Avatar Presence runtime
# Generate a random secret of at least 32 bytes. Never commit the real value.
EMPIRE_AVATAR_PRESENCE_SIGNING_SECRET=

# Private fast transcript spool. SESSION_OBSERVED only; never canonical truth.
EMPIRE_AVATAR_PRESENCE_FAST_SPOOL=/srv/empire_os/runtime/digital_avatar/presence_fast_transcripts


# Internal one-turn audio push. Separate from the public Presence signing secret.
# Generate a different random secret of at least 32 bytes.
EMPIRE_AVATAR_PRESENCE_AUDIO_PUSH_SECRET=

# Private one-time speech transmission tickets. Never expose through public gateway.
EMPIRE_AVATAR_SPEECH_TICKET_ROOT=/srv/empire_os/runtime/digital_avatar/speech_tickets
