# Empire Digital Avatar Ditto realtime visual GPU sidecar
# Deploy on the GPU host. The engine factory wraps the installed Ditto runtime.
EMPIRE_DITTO_AUTH_TOKEN=
EMPIRE_DITTO_ENGINE_FACTORY=
EMPIRE_DITTO_MAX_REFERENCE_IMAGE_BYTES=8000000
EMPIRE_DITTO_MAX_AUDIO_BYTES=12000000
EMPIRE_DITTO_MAX_FRAME_BYTES=512000
EMPIRE_DITTO_MAX_FRAMES_PER_TURN=9000
EMPIRE_DITTO_TEMP_ROOT=/var/lib/empire-ditto/tmp
