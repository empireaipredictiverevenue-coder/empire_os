# Empire Digital Avatar CosyVoice3 GPU sidecar
# Deploy on a GPU host. Never commit the real auth token.
EMPIRE_COSYVOICE3_AUTH_TOKEN=
EMPIRE_COSYVOICE3_MODEL_DIR=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
EMPIRE_COSYVOICE3_FP16=1
EMPIRE_COSYVOICE3_MAX_REFERENCE_AUDIO_BYTES=12000000
EMPIRE_COSYVOICE3_TEMP_ROOT=/var/lib/empire-cosyvoice/tmp
HF_HOME=/var/lib/empire-cosyvoice/huggingface
