# Empire Digital Avatar / Recall SHADOW ingress
# Create the workspace verification secret in the same Recall region used
# for the API key/bots. Never commit the real secret.
RECALL_REGION=
RECALL_API_KEY=
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Optional only for legacy Recall dashboard/Svix webhook endpoints.
RECALL_SVIX_WEBHOOK_SECRET=
EMPIRE_RECALL_PUBLIC_REALTIME_URL=https://empire-ai.co.uk/v1/providers/recall/realtime
EMPIRE_RECALL_PUBLIC_STATUS_URL=https://empire-ai.co.uk/v1/providers/recall/status

# Optional bounded runtime settings.
EMPIRE_RECALL_VERIFIED_SPOOL=/srv/empire_os/runtime/digital_avatar/recall_ingress
EMPIRE_RECALL_STATUS_SPOOL=/srv/empire_os/runtime/digital_avatar/recall_status_ingress
EMPIRE_RECALL_OBSERVATION_ROOT=/srv/empire_os/runtime/digital_avatar/observations
EMPIRE_RECALL_LIFECYCLE_ROOT=/srv/empire_os/runtime/digital_avatar/meeting_lifecycle
EMPIRE_RECALL_LIFECYCLE_LATEST_ROOT=/srv/empire_os/runtime/digital_avatar/lifecycle_latest
EMPIRE_RECALL_RUNTIME_STATE_ROOT=/srv/empire_os/runtime/digital_avatar/runtime_state
EMPIRE_RECALL_MEETING_STATE_ROOT=/srv/empire_os/runtime/digital_avatar/meeting_state
EMPIRE_RECALL_ACTIVATION_ROOT=/srv/empire_os/runtime/digital_avatar/activation_plans
EMPIRE_RECALL_MAX_PAYLOAD_BYTES=512000

# Optional private Copilot draft generation. Default remains disabled.
EMPIRE_AVATAR_PRIVATE_DRAFT_ENABLED=false
EMPIRE_AVATAR_PRIVATE_DRAFT_ROOT=/srv/empire_os/runtime/digital_avatar/private_drafts
EMPIRE_AVATAR_PRIVATE_DRAFT_STATUS=/srv/empire_os/runtime/digital_avatar/private_draft_status.json
EMPIRE_AVATAR_PRIVATE_DRAFT_POLL_SECONDS=1.0
EMPIRE_AVATAR_PRIVATE_DRAFT_MAX_PER_SCAN=3
