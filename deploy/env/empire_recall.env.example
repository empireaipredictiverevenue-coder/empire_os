# Empire Digital Avatar / Recall SHADOW ingress
# Create the workspace verification secret in the same Recall region used
# for the API key/bots. Never commit the real secret.
RECALL_REGION=
RECALL_WORKSPACE_VERIFICATION_SECRET=

# Optional bounded runtime settings.
EMPIRE_RECALL_VERIFIED_SPOOL=/srv/empire_os/runtime/digital_avatar/recall_ingress
EMPIRE_RECALL_MAX_PAYLOAD_BYTES=512000
