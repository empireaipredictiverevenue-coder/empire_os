# A2A runtime remains fail-closed until all three values are populated.
# Trusted keys JSON maps external agent key IDs to raw 32-byte Ed25519
# public keys encoded with standard/base64url-compatible base64.
EMPIRE_A2A_TRUSTED_ED25519_KEYS_JSON={"replace-agent-key-id":"replace-base64-public-key"}
EMPIRE_A2A_IDENTITY_DSN=postgresql://REPLACE
EMPIRE_A2A_INTENT_DSN=postgresql://REPLACE
