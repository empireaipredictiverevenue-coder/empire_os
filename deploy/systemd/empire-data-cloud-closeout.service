[Unit]
Description=EmpireDB governed closeout engineering wave
After=network-online.target empire-omniroute.service
Wants=network-online.target
Requires=empire-omniroute.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=HOME=/home/ubuntu
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_AUTONOMOUS_MODE=OBSERVE
EnvironmentFile=-/etc/empire_os/omniroute-hermes.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_empiredb_closeout_wave.py --max-parallel 4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/empire_os/.git /srv/empire_os/runtime -/var/tmp/empire-pi -/var/tmp/empire-coder-sandbox -/home/ubuntu/.hermes -/home/ubuntu/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=7200
