[Unit]
Description=EmpireOS automated business optimization recommendation cycle
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_business_optimization_cycle.py --max-requests 24 --benchmark-variable-limit 18
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/empire_os
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=300
