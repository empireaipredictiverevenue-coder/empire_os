[Unit]
Description=EmpireOS deterministic PLAN fast-path drain
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_coder_plan_fastpath.py --max-jobs 80
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
RestrictSUIDSGID=true
LockPersonality=true
IPAddressDeny=any
TimeoutStartSec=120
