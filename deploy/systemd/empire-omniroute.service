[Unit]
Description=Empire OmniRoute local AI gateway
After=network-online.target
Wants=network-online.target
Before=empire-hermes-control.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=HOME=/home/ubuntu
Environment=PORT=20128
Environment=OMNIROUTE_SERVER_HOST=127.0.0.1
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_PUBLIC_BASE_URL=http://127.0.0.1:20128
Environment=BASE_URL=http://127.0.0.1:20128
Environment=NODE_ENV=production
Environment=REQUIRE_API_KEY=false
Environment=ALLOW_API_KEY_REVEAL=false
EnvironmentFile=-/home/ubuntu/.omniroute/.env
ExecStart=/bin/bash /srv/empire_os/scripts/run_omniroute.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=40

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.omniroute
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
