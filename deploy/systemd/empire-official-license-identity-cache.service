[Unit]
Description=Refresh EmpireOS official license identity cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_official_license_identity_cache.py --repo-root /srv/empire_os
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=90
