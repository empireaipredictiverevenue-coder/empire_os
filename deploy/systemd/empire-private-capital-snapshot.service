[Unit]
Description=EmpireOS Private Capital intelligence snapshot
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_private_capital_snapshot.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=180
