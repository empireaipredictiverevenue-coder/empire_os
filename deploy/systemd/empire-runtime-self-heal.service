[Unit]
Description=EmpireOS deterministic runtime self-heal controller
After=network-online.target empire-ops-privileged-helper.service
Wants=network-online.target empire-ops-privileged-helper.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_AUTONOMOUS_MODE=OBSERVE
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_runtime_self_heal.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime/self_heal
TimeoutStartSec=120
