[Unit]
Description=EmpireOS governed outbound worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=/srv/empire_os/runtime/secrets/outbound.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/outbound_governor_worker.py --limit 25 --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=120
