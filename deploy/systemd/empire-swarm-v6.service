[Unit]
Description=EmpireOS governed Swarm V6 verification cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
CPUWeight=25
IOWeight=25
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_swarm_v6.py --max-workers 3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=300
