[Unit]
Description=EmpireOS Predictive Cloud owned runtime materializer
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os

ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_predictive_cloud_materializer.py

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadWritePaths=/srv/empire_os/runtime

IPAddressDeny=any
RestrictSUIDSGID=true
LockPersonality=true

TimeoutStartSec=60
