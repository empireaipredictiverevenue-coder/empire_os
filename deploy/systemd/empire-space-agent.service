[Unit]
Description=Empire Space Agent Founder Workspace
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/empire/space-agent/source
ExecStart=/opt/empire/space-agent/bin/node /opt/empire/space-agent/source/space.js serve HOST=localhost PORT=3010 CUSTOMWARE_PATH=/var/lib/empire/space-agent/customware LOGIN_ALLOWED=true ALLOW_GUEST_USERS=false CLOUD_SHARE_ALLOWED=false CUSTOMWARE_GIT_HISTORY=true WORKERS=1
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
UMask=0077
ReadOnlyPaths=/opt/empire/space-agent/source
ReadWritePaths=/var/lib/empire/space-agent
InaccessiblePaths=/srv/empire_os
InaccessiblePaths=/etc/empire_os.env
InaccessiblePaths=/home/ubuntu/.ssh
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
