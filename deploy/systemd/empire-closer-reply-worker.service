[Unit]
Description=EmpireOS classified reply to closer handoff
After=network-online.target empire-resend-inbound.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=/srv/empire_os/runtime/secrets/outbound.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_closer_reply_worker.py --limit 50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=90
