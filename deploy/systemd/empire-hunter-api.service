[Unit]
Description=Empire Hunter internal API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python -m uvicorn empire_os.hunter.api:app --host 127.0.0.1 --port 8770 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime

[Install]
WantedBy=default.target
