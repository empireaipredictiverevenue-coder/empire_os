[Unit]
Description=EmpireOS Supabase egress self-healing guard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_supabase_egress_guard.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=180
