[Unit]
Description=Build governed LinkedIn Revenue Department review snapshot
After=network-online.target empire-buyer-acquisition-scout.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=-/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/build_linkedin_revenue_department.py --repo-root /srv/empire_os
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=120
