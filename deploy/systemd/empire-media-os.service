[Unit]
Description=Empire Media OS internal runtime refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStartPre=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_media_empire_bridge.py --repo-root /srv/empire_os --git-limit 30
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_media_os_runtime.py --repo-root /srv/empire_os
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=300
