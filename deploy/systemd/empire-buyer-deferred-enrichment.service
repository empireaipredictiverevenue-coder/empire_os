[Unit]
Description=EmpireOS deferred buyer enrichment and call-ready fallback
After=network-online.target
Wants=network-online.target
OnSuccess=empire-buyer-review-materializer.service
OnSuccess=empire-company-routed-buyer-review.service

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empiredb.env
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=/srv/empire_os/runtime/secrets/outbound.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_buyer_deferred_enrichment.py --limit 48 --workers 8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=300
