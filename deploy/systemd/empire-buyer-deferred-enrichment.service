[Unit]
Description=EmpireOS deferred buyer enrichment and call-ready fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=/srv/empire_os/runtime/secrets/outbound.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_buyer_deferred_enrichment.py --limit 10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=300
