[Unit]
Description=Empire Gmail HTTPS Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=-/srv/empire_os/runtime/secrets/gmail-relay.env
ExecStart=/srv/empire_os/.venv/bin/uvicorn empire_os.empire_mail_relay_app:app --host 127.0.0.1 --port 8775
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
