[Unit]
Description=EmpireOS Real Prospect Acquisition Cycle
After=network-online.target
Wants=network-online.target
OnSuccess=empire-qualification.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
Environment=CRAWLER_TIMEOUT=600
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_acquisition_cycle.py --max-candidates 10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=900
