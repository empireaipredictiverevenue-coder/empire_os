[Unit]
Description=EmpireOS Canonical Lead Qualification v2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_qualification_cycle.py --limit 10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=900
