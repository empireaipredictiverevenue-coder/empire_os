[Unit]
Description=EmpireOS CosyVoice3 Digital Avatar GPU sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
EnvironmentFile=-/etc/empire_cosyvoice3.env
Environment=HF_HOME=/var/lib/empire-cosyvoice/huggingface
ExecStart=/srv/empire_os/.venv/bin/python -m uvicorn --factory empire_os.cosyvoice3_sidecar_service:app_from_env --host 127.0.0.1 --port 8110 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/empire_os
ReadWritePaths=/var/lib/empire-cosyvoice

[Install]
WantedBy=multi-user.target
