[Unit]
Description=EmpireOS Predictive Revenue enterprise target activation
After=network-online.target empire-commercial-product-catalog.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_AUTONOMOUS_MODE=OBSERVE
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/activate_predictive_revenue_enterprise_targets.py
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_buyer_acquisition_team.py --repo-root /srv/empire_os
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=1800
