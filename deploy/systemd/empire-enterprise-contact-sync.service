[Unit]
Description=EmpireOS enterprise contact intelligence sync
After=network-online.target empire-ops-privileged-helper.service
Wants=network-online.target
OnFailure=empire-enterprise-contact-repair.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_AUTONOMOUS_MODE=OBSERVE
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_enterprise_contact_sync_cycle.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=300
