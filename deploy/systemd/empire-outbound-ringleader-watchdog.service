[Unit]
Description=EmpireOS Ringleader observer heartbeat watchdog
After=empire-outbound-ringleader-observer.timer
Wants=empire-outbound-ringleader-observer.timer

[Service]
Type=oneshot
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_OUTBOUND_OBSERVER_MAX_AGE_MINUTES=15
EnvironmentFile=-/srv/empire_os/runtime/secrets/outbound-deliverability.env
ExecStart=/srv/empire_os/.venv/bin/python -m empire_os.outbound_ringleader_watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc /srv/empire_os/runtime
TimeoutStartSec=20
