[Unit]
Description=Empire AI Self-Serve Checkout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_SELF_SERVE_PAYMENT_PROPOSAL_AUTHORIZED=OFF
ExecStart=/srv/empire_os/.venv/bin/python -m uvicorn empire_os.self_serve_checkout_api:app --host 127.0.0.1 --port 8098 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/empire_os

[Install]
WantedBy=multi-user.target
