[Unit]
Description=Refresh EmpireOS Phase 4 Buyer Acquisition Team plan
After=network-online.target empire-commercial-exchange.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_buyer_acquisition_team.py --repo-root /srv/empire_os
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
TimeoutStartSec=120
