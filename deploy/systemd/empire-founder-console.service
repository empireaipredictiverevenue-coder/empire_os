[Unit]
Description=EmpireOS Founder Console
After=network-online.target empire-founder-dashboard-api.service
Wants=network-online.target empire-founder-dashboard-api.service

[Service]
Type=simple
WorkingDirectory=/srv/empire_os/apps/search-command-centre
Environment=NODE_ENV=production
Environment=EMPIRE_API_BASE_URL=http://127.0.0.1:8766
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.2/bin/node /srv/empire_os/apps/search-command-centre/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/srv/empire_os

[Install]
WantedBy=default.target
