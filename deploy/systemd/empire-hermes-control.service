[Unit]
Description=Empire Hermes governed resident worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=HOME=/home/ubuntu
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_AUTONOMOUS_MODE=OBSERVE
Environment=EMPIRE_HERMES_GOVERNED_WORKER=1
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_hermes_control_worker.py --repo-root /srv/empire_os --control-branch ops/hermes-control --max-jobs 1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/empire_os/.git /srv/empire_os/runtime/hermes_control -/home/ubuntu/.hermes -/home/ubuntu/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
TimeoutStartSec=1900

[Install]
WantedBy=multi-user.target
