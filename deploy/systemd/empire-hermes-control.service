[Unit]
Description=Empire Hermes governed resident worker
After=network-online.target empire-omniroute.service
Wants=network-online.target empire-omniroute.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=EMPIRE_HERMES_BIN=/home/ubuntu/.local/bin/hermes
Environment=PYTHONPATH=/srv/empire_os
Environment=EMPIRE_AUTONOMOUS_MODE=OBSERVE
Environment=EMPIRE_HERMES_GOVERNED_WORKER=1
EnvironmentFile=-/etc/empire_os/omniroute-hermes.env
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_hermes_control_worker.py --repo-root /srv/empire_os --control-branch ops/hermes-control --max-jobs 1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/empire_os/.git /srv/empire_os/runtime -/home/ubuntu/.hermes -/home/ubuntu/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
TimeoutStartSec=1900

[Install]
WantedBy=multi-user.target
