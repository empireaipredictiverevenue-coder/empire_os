[Unit]
Description=EmpireOS dedicated VERIFY evidence drain
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_coder_verify_drain.py --max-jobs 4
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/empire_os/runtime /srv/empire_os/.pytest_cache
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=300
