[Unit]
Description=EmpireOS Native Ops MCP
After=network-online.target empire-ops-privileged-helper.service
Wants=network-online.target empire-ops-privileged-helper.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python -m empire_os.ops_mcp --transport streamable-http --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
