[Unit]
Description=Materialize evidence-backed Empire opportunity briefs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/run_opportunity_briefs.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
