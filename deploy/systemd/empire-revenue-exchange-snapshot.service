[Unit]
Description=EmpireOS canonical Revenue Exchange read-only snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=/etc/empire_os.env
EnvironmentFile=/etc/empiredb.env
Environment=PYTHONPATH=/srv/empire_os
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/refresh_revenue_exchange_snapshot.py --repo-root /srv/empire_os --limit 500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime/revenue_exchange

[Install]
WantedBy=multi-user.target
