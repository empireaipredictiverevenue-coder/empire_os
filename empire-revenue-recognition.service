[Unit]
Description=Empire AI Phase 3F Revenue Recognition
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=-/srv/empire_os/.env.revenue_recognition
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/revenue_recognition_worker.py --limit 25 --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
