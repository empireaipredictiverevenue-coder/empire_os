[Unit]
Description=Empire OS Strategist Agent — Weekly Revenue Architecture
After=network.target empire-hub-8081.service
Wants=empire-hub-8081.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/empire_os
ExecStart=/root/venv/bin/python3 -m empire_os.agents.strategist_agent
Restart=always
RestartSec=300
Environment=PYTHONUNBUFFERED=1 OLLAMA_HOST=http://127.0.0.1:11434 LLM_MODEL=llama3.1:8b
StandardOutput=append:/root/empire_os/logs/strategist_agent.log
StandardError=append:/root/empire_os/logs/strategist_agent.log

[Install]
WantedBy=multi-user.target