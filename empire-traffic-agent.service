[Unit]
Description=Empire OS Traffic Specialist Agent (recommendation engine)
After=network-online.target empire-hub-8081.service
Wants=network-online.target
ConditionPathExists=/root/empire_os/empire_os.db

[Service]
Type=simple
User=root
WorkingDirectory=/root/empire_os
Environment=PYTHONUNBUFFERED=1
Environment=EMPIRE_INPROC_AGENTS=0
Environment=HUB_LOOP_INPROC=0
Environment=LLM_BASE_URL=
Environment=LLM_MODEL=minimax/minimax-m2.7:free
ExecStart=/root/venv/bin/python3 -m empire_os.agents.traffic_agent
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
