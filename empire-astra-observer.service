[Unit]
Description=Empire AI Phase 4 Astra Observer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=-/srv/empire_os/.env.astra_observer
ExecStart=/srv/empire_os/.venv/bin/python /srv/empire_os/scripts/astra_observer.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/empire_os/runtime
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
