[Unit]
Description=Empire AI Resend Inbound Webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/empire_os
EnvironmentFile=-/srv/empire_os/.env
ExecStart=/srv/empire_os/.venv/bin/python -m uvicorn empire_os.resend_webhook_app:app --host 127.0.0.1 --port 8097 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
